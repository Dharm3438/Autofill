# Nothing is needed here. The app calls the API on its own domain (/api).
# In production the Cloudflare Pages Function functions/api/[[path]].js
# forwards /api/* to the Render backend (set BACKEND_URL in the Pages project
# settings to override its default URL). In development vite.config.js proxies
# /api to your local backend.
# VITE_API_URL is no longer read — remove it from the Pages project settings.
