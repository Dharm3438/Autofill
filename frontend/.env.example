# Backend URL (no trailing /api). The browser calls it directly.
# Required for production builds (vite.config.js fails the build without it) —
# set it in the Cloudflare Pages project settings for Production and Preview.
# Leave it unset in development: the app then calls /api and vite.config.js
# proxies that to your local backend.
# VITE_API_URL=https://autofill-blgf.onrender.com
